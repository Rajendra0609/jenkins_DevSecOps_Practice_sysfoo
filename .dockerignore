# BUG FIX: this file is the real .dockerignore Docker actually reads. A more
# thorough version of it existed in the repo, but saved under the filename
# "dockerignore" (missing the leading dot) — Docker never reads that name, so
# it was completely inert and this shorter list was the one silently in
# effect the whole time. Replaced with the more complete version below and
# removed the dead misnamed file.

# ── Build output (builder stage copies source, not target) ───────
target/

# ── IDE / editor files ────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.classpath
.project
.factorypath

# ── OS noise ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Git metadata ──────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI / DevOps artefacts ─────────────────────────────────────────
Jenkinsfile
.github/
.gitlab-ci.yml
*.jenkinsfile

# ── Docker files themselves ───────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Security & secret scan reports ───────────────────────────────
gitleaks-report.json
owasp-reports/
trivy-reports/
*.sarif

# ── Test & coverage reports ───────────────────────────────────────
surefire-reports/
site/
*.exec

# ── Local SQLite databases (never bake DB into image) ────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/

# ── Log files ─────────────────────────────────────────────────────
*.log
logs/

# ── Maven wrapper cache ───────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── Docs & markdown ───────────────────────────────────────────────
README.md
docs/
*.md
