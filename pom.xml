<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>sysfoo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!--
        UPDATE: packaging is now "war" instead of the implicit default "jar".
        This is Spring Boot's own documented pattern for producing a SINGLE
        artifact that works two ways:
          1) java -jar target/sysfoo-0.0.1-SNAPSHOT.war  — runs standalone with
             an embedded Tomcat, exactly like the old executable jar did.
          2) Deploy the same .war into an external/standalone Tomcat server's
             webapps/ directory.
        See SysfooApplication.java (SpringBootServletInitializer) and the
        spring-boot-starter-tomcat dependency below (scope=provided) — those
        two changes are what make this work. Nothing else about how the app
        runs, or which environment variables it reads, changes.
    -->
    <packaging>war</packaging>
    <name>sysfoo</name>
    <description>A web application to display system and environment info.</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- ── Spring Boot Starters ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            UPDATE: needed for the dual jar/war packaging above. scope=provided
            means "an external Tomcat already provides this — don't bundle it
            when deployed there." It does NOT break standalone execution:
            Spring Boot's repackaged executable WAR still includes provided-
            scope jars in its own internal lib folder for `java -jar ...war`,
            and `mvn spring-boot:run` always includes provided-scope
            dependencies on its dev-time classpath by design, specifically for
            this scenario. Without this, deploying the war to a real Tomcat
            would ship a second, conflicting embedded Tomcat inside it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            BUG FIX: Dockerfile's HEALTHCHECK calls GET /actuator/health, but this
            dependency was missing — that endpoint never existed, so the container
            health check failed 100% of the time (every check got a 404), and any
            orchestrator (Docker, Kubernetes, ECS, etc.) that watches container
            health would see it as permanently "unhealthy" and restart/kill it in
            a loop, even though the app itself was running fine.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── JPA API ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!--
            Hibernate Community Dialects — provides SQLiteDialect.
            Required for Hibernate 6 (Spring Boot 3.x).
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- ── SQLite  (default / dev / CI database) ─────────────────────── -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── H2 Database (test profile / CI) ───────────────────────────── -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ── PostgreSQL (prod database) ───────────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Testing ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- pom.xml -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
